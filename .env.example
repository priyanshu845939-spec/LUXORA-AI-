# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# DEEPSEEK_API_KEY: Optional secondary AI provider API key.
DEEPSEEK_API_KEY=""

# JWT_SECRET: Secret key for signing user authentication session tokens.
JWT_SECRET=""

# RAZORPAY_KEY_ID: Razorpay key id for INR payments (Test or Live).
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay key secret for verifying webhook and HMAC signatures.
RAZORPAY_KEY_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
